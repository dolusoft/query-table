{
  "name": "@dolusoft/query-table",
  "version": "3.1.0",
  "description": "A thin Vue 3 table for server-side data: it renders rows and emits sort, filter, search and paging changes. Built on TanStack Table.",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/query-table.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/query-table.js"
    },
    "./local": {
      "types": "./dist/types/local/index.d.ts",
      "default": "./dist/local.js"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dolusoft/query-table.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/dolusoft/query-table/issues"
  },
  "homepage": "https://github.com/dolusoft/query-table#readme",
  "keywords": [
    "vue",
    "vue3",
    "table",
    "datatable",
    "server-side",
    "pagination",
    "sorting",
    "filter",
    "tanstack"
  ],
  "license": "MIT",
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node ../../scripts/emit-type-extensions.mjs dist/types"
  },
  "dependencies": {
    "@dolusoft/query-protocol": "workspace:*",
    "@dolusoft/query-table-core": "workspace:*",
    "@tanstack/vue-table": "9.2.6"
  },
  "devDependencies": {
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
