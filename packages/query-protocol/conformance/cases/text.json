        {
          "id": "C12.2",
          "query": {
            "page": 1,
            "pageSize": 50,
            "sort": null,
            "filters": [{ "field": "city", "condition": "Contains", "value": "I\u011eD" }]
          },
          "expect": { "keys": [4, 8], "totalRows": 2 }
        },
        {
          "id": "C12.3",
          "query": {
            "page": 1,
            "pageSize": 50,
            "sort": null,
            "filters": [{ "field": "name", "condition": "Contains", "value": "i" }]
          },
          "expect": { "keys": [1, 2, 3, 8], "totalRows": 4 }
        }
      ]
    },
