      "profile": "tr-1",
      "data": { "ref": "../data/people.json" },
      "runs": [
        {
          "id": "C12.1",
          "query": {
            "page": 1,
            "pageSize": 50,
            "sort": null,
            "filters": [{ "field": "city", "condition": "Equal", "value": "istanbul" }]
