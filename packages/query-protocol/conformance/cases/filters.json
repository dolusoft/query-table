    {
      "id": "C15",
      "title": "A text condition on a number; no type conversion",
      "profile": "tr-1",
      "data": { "ref": "../data/people.json" },
      "runs": [
        {
          "id": "C15.1",
          "query": {
            "page": 1,
            "pageSize": 50,
            "sort": null,
            "filters": [{ "field": "age", "condition": "Contains", "value": 2 }]
          },
          "expect": {
            "error": {
              "code": "unsupported-operator",
              "field": "age",
              "rule": 0,
              "path": "/filters/0/condition"
            }
          }
        },
        {
          "id": "C15.2",
          "query": {
            "page": 1,
            "pageSize": 50,
            "sort": null,
            "filters": [{ "field": "age", "condition": "Equal", "value": "25" }]
          },
          "expect": {
            "error": { "code": "invalid-value", "field": "age", "rule": 0, "path": "/filters/0/value" }
          }
        }
      ]
    },
