{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./playground/skin/*"],
      "@dolusoft/query-table": ["./src/index.ts"],
      "@dolusoft/query-protocol": ["./packages/query-protocol/src/index.ts"],
      "@dolusoft/query-protocol/query.schema.json": ["./packages/query-protocol/query.schema.json"],
      "@dolusoft/query-table-core": ["./packages/query-table-core/src/index.ts"],
      "@dolusoft/query-table-core/*": ["./packages/query-table-core/src/features/*/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/tests/**/*.ts", "packages/*/*.config.ts", "fixtures/packages/*.ts", "contract/**/*.ts", "docs/guide/**/*.ts", "src/**/*.ts", "src/**/*.vue", "tests/**/*.ts", "tests/**/*.vue", "playground/**/*.ts", "playground/**/*.vue", "spike/**/*.ts", "*.config.ts"]
}
