{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@/*": ["./tests/browser/*"] }
  },
  "include": ["contract/**/*.ts", "src/**/*.ts", "src/**/*.vue", "test-support/**/*.ts", "tests/**/*.ts", "tests/**/*.vue", "*.config.ts"]
}
