{
  "name": "@dolusoft/vue-server-table",
  "version": "2.2.3",
  "description": "A thin Vue 3 table for server-side data: it renders rows and emits sort, filter and paging changes.",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue-server-table.cjs",
  "module": "./dist/vue-server-table.js",
  "types": "./dist/types/components/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/components/index.d.ts",
        "default": "./dist/vue-server-table.js"
      },
      "require": {
        "types": "./dist/types/components/index.d.cts",
        "default": "./dist/vue-server-table.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dolusoft/vue-server-table.git"
  },
  "bugs": {
    "url": "https://github.com/dolusoft/vue-server-table/issues"
  },
  "homepage": "https://github.com/dolusoft/vue-server-table#readme",
  "keywords": [
    "vue",
    "vue3",
    "table",
    "datatable",
    "server-side",
    "pagination",
    "sorting",
    "filter"
  ],
  "license": "MIT",
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/emit-cjs-types.mjs",
    "lint": "eslint src contract",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:browser": "node scripts/test-browser.mjs",
    "test:browser:headless": "node scripts/test-browser.mjs --browser.headless",
    "test:browser:inspect": "vitest --project browser --mode inspect --watch",
    "analyze:build": "vite build -c vite.analyze.config.ts",
    "check:package": "pnpm build && node scripts/check-no-css.mjs && publint && attw --pack . --profile node16",
    "knip": "knip",
    "contract:gen": "node scripts/gen-contract.mjs",
    "contract:check": "node scripts/gen-contract.mjs --check",
    "api:check": "pnpm build && api-extractor run",
    "api:update": "pnpm build && api-extractor run --local"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@lucide/vue": "^1.52.0",
    "@microsoft/api-extractor": "^7.59.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/devtools": "0.7.6",
    "@vitejs/devtools-rolldown": "0.7.6",
    "@vitejs/devtools-vite": "0.7.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "knip": "^6.39.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "reka-ui": "^2.10.5",
    "shadcn": "^4.21.1",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "^5.0.3",
    "vitest-browser-vue": "^3.1.0",
    "vue": "^3.5.43",
    "vue-component-meta": "^3.3.12",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
