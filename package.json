{
  "name": "@dolusoft/query-table",
  "version": "2.2.12",
  "description": "A thin Vue 3 table for server-side data: it renders rows and emits sort, filter and paging changes.",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/query-table.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/query-table.js"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.4.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dolusoft/query-table.git"
  },
  "bugs": {
    "url": "https://github.com/dolusoft/query-table/issues"
  },
  "homepage": "https://github.com/dolusoft/query-table#readme",
  "keywords": [
    "vue",
    "vue3",
    "table",
    "datatable",
    "server-side",
    "pagination",
    "sorting",
    "filter"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite -c playground/vite.config.ts",
    "playground:build": "vite build -c playground/vite.config.ts",
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/emit-type-extensions.mjs",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:browser": "node scripts/test-browser.mjs",
    "test:browser:headless": "node scripts/test-browser.mjs --browser.headless",
    "test:browser:inspect": "vitest --project browser --mode inspect --watch",
    "measure:renders": "node scripts/measure-renders.mjs",
    "check:renders": "node scripts/measure-renders.mjs --check",
    "analyze:build": "vite build -c vite.analyze.config.ts",
    "analyze:build:json": "node scripts/analyze-build.mjs",
    "measure:consumer-size": "pnpm build && node scripts/consumer-size.mjs",
    "check:size": "node scripts/consumer-size.mjs --check",
    "check:package": "node scripts/check-dist-fresh.mjs && node scripts/check-no-css.mjs && publint && attw --pack . --profile esm-only",
    "knip": "knip",
    "contract:gen": "node scripts/gen-contract.mjs",
    "contract:check": "node scripts/gen-contract.mjs --check",
    "api:check": "node scripts/check-dist-fresh.mjs && api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.52.0",
    "@microsoft/api-extractor": "^7.59.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@vitejs/devtools": "0.7.6",
    "@vitejs/devtools-rolldown": "0.7.6",
    "@vitejs/devtools-vite": "0.7.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "axe-core": "^4.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "knip": "^6.39.0",
    "minisearch": "^7.2.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "reka-ui": "^2.10.5",
    "shadcn": "^4.21.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "^5.0.3",
    "vitest-browser-vue": "^3.1.0",
    "vue": "^3.5.43",
    "vue-component-meta": "^3.3.12",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.12"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
