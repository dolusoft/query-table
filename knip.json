{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "contract/dom.ts",
        "scripts/*.mjs",
        "apps/playground/examples/*.vue",
        "apps/playground/skin/gen-skin.ts",
        "fixtures/packages/*.ts",
        "docs/guide/examples/*.ts"
      ],
      "project": [
        "docs/guide/**/*.ts",
        "contract/**/*.ts",
        "scripts/*.mjs",
        "tests/**/*.ts",
        "apps/playground/**/*.{ts,vue,css}",
        "fixtures/packages/*.ts"
      ],
      "ignore": [
        "apps/playground/skin/ui/table/TableFooter.vue",
        "apps/playground/skin/mapping.css",
        "apps/playground/skin/theme.css"
      ]
    },
    "packages/query-protocol": {
      "entry": ["src/index.ts", "src/local/index.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/query-table-core": {
      "entry": ["src/index.ts", "src/features/*/index.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/vue": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,vue}"]
    }
  },
  "ignoreIssues": {
    "packages/vue/src/**/*.vue": ["types"]
  }
}
